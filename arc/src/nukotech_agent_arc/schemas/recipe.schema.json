{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nukotech.invalid/agent-arc/recipe-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "purpose",
    "authority_profile",
    "components",
    "requested_capabilities",
    "side_effects",
    "stop_conditions",
    "acceptance_tests",
    "receipt_policy"
  ],
  "properties": {
    "schema": {"const": "nukotech.agent_arc.recipe.v1"},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "authority_profile": {"type": "string", "minLength": 1},
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "type", "sha256"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "type": {
            "enum": [
              "governance_or_harness",
              "skill",
              "loop",
              "graph_or_memory_binding",
              "runtime_binding",
              "protocol"
            ]
          },
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "requested_capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "side_effects": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "acceptance_tests": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "receipt_policy": {"type": "string", "minLength": 1}
  }
}
