{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nukotech.invalid/agent-arc/composition-receipt-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "composer_version",
    "recipe",
    "registry_version",
    "authorization_id",
    "authorization_subject",
    "architecture_manifest_sha256",
    "component_hashes",
    "security_decisions"
  ],
  "properties": {
    "schema": {"const": "nukotech.agent_arc.composition_receipt.v1"},
    "status": {"const": "COMPOSED"},
    "composer_version": {"type": "string"},
    "recipe": {"type": "object", "required": ["id", "version"]},
    "registry_version": {"type": "string"},
    "authorization_id": {"type": "string"},
    "authorization_subject": {"type": "string", "minLength": 1},
    "architecture_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "component_hashes": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "security_decisions": {"type": "array", "minItems": 2}
  }
}
