{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nukotech.invalid/agent-arc/component.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "type",
    "sha256",
    "path",
    "license",
    "provenance",
    "dependencies",
    "conflicts",
    "capabilities",
    "side_effects",
    "stop_conditions",
    "rollback"
  ],
  "properties": {
    "schema": {"const": "nukotech.agent_arc.component.v1"},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "type": {
      "enum": [
        "governance_or_harness",
        "skill",
        "loop",
        "graph_or_memory_binding",
        "runtime_binding",
        "protocol"
      ]
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1},
    "license": {"type": "string", "minLength": 1},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "owner"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1}
      }
    },
    "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "conflicts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "side_effects": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "rollback": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
