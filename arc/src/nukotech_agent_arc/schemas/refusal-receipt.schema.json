{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nukotech.invalid/agent-arc/refusal-receipt-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "composer_version",
    "recipe",
    "registry_version",
    "issues",
    "security_decisions"
  ],
  "properties": {
    "schema": {"const": "nukotech.agent_arc.refusal_receipt.v1"},
    "status": {"const": "REFUSED"},
    "composer_version": {"type": "string"},
    "recipe": {"type": "object", "required": ["id", "version"]},
    "registry_version": {"type": "string"},
    "issues": {"type": "array", "minItems": 1},
    "security_decisions": {"type": "array"}
  }
}
