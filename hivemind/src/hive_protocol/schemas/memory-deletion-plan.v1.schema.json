{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nukotech.invalid/hive/memory-deletion-plan.v1.schema.json",
  "title": "Hive memory deletion plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "node_id", "node_sha256", "tenant_id", "project_id", "experience_scope", "owned_paths", "risk_class", "checkpoint_required", "created_at", "expires_at"],
  "properties": {
    "schema_version": {"const": "hive.memory-deletion-plan.v1"},
    "plan_id": {"type": "string", "pattern": "^delete:[0-9a-f]{64}$"},
    "node_id": {"type": "string", "pattern": "^node:[0-9a-f]{64}$"},
    "node_sha256": {"$ref": "#/$defs/sha256"},
    "tenant_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "experience_scope": {"$ref": "#/$defs/scope"},
    "owned_paths": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^prime/[A-Za-z0-9._/-]+\\.(md|json)$"}},
    "risk_class": {"const": "HIGH"},
    "checkpoint_required": {"const": true},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scope": {"type": "object", "additionalProperties": false, "required": ["kind", "owner_id"], "properties": {"kind": {"enum": ["PERSONA", "SURFACE", "DOMAIN", "SHARED"]}, "owner_id": {"$ref": "#/$defs/id"}}}
  }
}
