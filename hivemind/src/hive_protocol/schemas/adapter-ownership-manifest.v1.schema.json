{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nukotech.invalid/hive/adapter-ownership-manifest.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "installation_id", "adapter_id", "adapter_version",
    "root", "created_at", "paths"
  ],
  "properties": {
    "schema_version": {"const": "hive.adapter-ownership-manifest.v1"},
    "installation_id": {"$ref": "#/$defs/safe_id"},
    "adapter_id": {"$ref": "#/$defs/safe_id"},
    "adapter_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"
    },
    "root": {"type": "string", "minLength": 1, "maxLength": 4096},
    "created_at": {"type": "string", "format": "date-time"},
    "paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 4096},
          "kind": {"enum": ["file", "directory"]},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  },
  "$defs": {
    "safe_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
