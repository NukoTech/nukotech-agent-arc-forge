{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nukotech.invalid/hive/knowledge-edge.v1.schema.json",
  "title": "Hive knowledge edge v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "edge_id", "tenant_id", "project_id", "source_node_id", "target_node_id", "relation", "evidence_anchor_ids", "created_at"],
  "properties": {
    "schema_version": {"const": "hive.knowledge-edge.v1"},
    "edge_id": {"type": "string", "pattern": "^edge:[0-9a-f]{64}$"},
    "tenant_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "source_node_id": {"$ref": "#/$defs/node_id"},
    "target_node_id": {"$ref": "#/$defs/node_id"},
    "relation": {"enum": ["RELATES_TO", "MEMBER_OF", "CONTAINS", "SUPPORTS", "DEPENDS_ON", "CITES", "SUPERSEDES", "REVOKES", "CORRECTS", "CONTRADICTS"]},
    "evidence_anchor_ids": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "node_id": {"type": "string", "pattern": "^node:[0-9a-f]{64}$"}
  }
}
