{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nukotech.invalid/hive/application-adapter-manifest.v1.schema.json",
  "title": "Hive Application Adapter Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "adapter_id", "name", "version", "maintainer",
    "capability_ids", "execution_mode", "platforms", "required_permissions",
    "accepted_data_classifications", "request_schema", "result_schema", "events",
    "network_destinations", "credential_references", "dependencies", "health_check",
    "export", "revocation_check", "rollback", "uninstall", "resource_limits",
    "retention", "offline_behavior", "signer_policy"
  ],
  "properties": {
    "schema_version": {"const": "hive.application-adapter-manifest.v1"},
    "adapter_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 128},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"},
    "maintainer": {"type": "string", "minLength": 1, "maxLength": 256},
    "capability_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9._:-]{1,128}$"}
    },
    "execution_mode": {"enum": ["NATIVE", "OPEN_SOURCE_WRAPPED", "VENDOR_API", "MANUAL_BRIDGE"]},
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["os", "architecture", "runtime"],
        "properties": {
          "os": {"enum": ["linux", "windows", "macos"]},
          "architecture": {"enum": ["x86_64", "aarch64", "arm64"]},
          "runtime": {"type": "string", "minLength": 1}
        }
      }
    },
    "required_permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9._:-]{1,128}$"}
    },
    "accepted_data_classifications": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "NON_PRIVATE", "PROJECT_PRIVATE", "SURFACE_PRIVATE",
          "PERSONA_PRIVATE", "CUSTOMER_PRIVATE", "PRIME_SHARED"
        ]
      }
    },
    "request_schema": {"type": "string", "minLength": 1},
    "result_schema": {"type": "string", "minLength": 1},
    "events": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9._:-]{1,128}$"}
    },
    "network_destinations": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "format": "uri"}
    },
    "credential_references": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(keychain|secret-service|credential-manager|manual):[A-Za-z0-9._:/-]{1,256}$"
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "sha256", "license"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "license": {"type": "string", "minLength": 1}
        }
      }
    },
    "health_check": {"$ref": "#/$defs/command"},
    "export": {"$ref": "#/$defs/command"},
    "revocation_check": {"$ref": "#/$defs/command"},
    "rollback": {"$ref": "#/$defs/command"},
    "uninstall": {"$ref": "#/$defs/command"},
    "resource_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_input_bytes", "max_output_bytes", "timeout_seconds"],
      "properties": {
        "max_input_bytes": {"type": "integer", "minimum": 1, "maximum": 1073741824},
        "max_output_bytes": {"type": "integer", "minimum": 1, "maximum": 1073741824},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "delete_method"],
      "properties": {
        "policy": {"type": "string", "minLength": 1},
        "delete_method": {"type": "string", "minLength": 1}
      }
    },
    "offline_behavior": {"enum": ["SUPPORTED", "QUEUE_AND_RECONCILE", "REFUSE_CLOSED"]},
    "signer_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "allowed_key_ids"],
      "properties": {
        "issuer": {"type": "string", "minLength": 1},
        "allowed_key_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entrypoint", "timeout_seconds"],
      "properties": {
        "entrypoint": {"type": "string", "minLength": 1},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
      }
    }
  }
}
