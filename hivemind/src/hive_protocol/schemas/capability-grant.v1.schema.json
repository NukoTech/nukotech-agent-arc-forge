{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nukotech.invalid/hive/capability-grant.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "grant_id", "tenant_id", "workspace_id", "project_id",
    "agent_id", "persona_id", "surface_id", "machine_id", "app_actor",
    "capabilities", "trust_level", "issued_at", "expires_at", "issuer", "signature"
  ],
  "properties": {
    "schema_version": {"const": "hive.capability-grant.v1"},
    "grant_id": {"type": "string", "format": "uuid"},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "workspace_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "project_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
    "agent_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
    "persona_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "surface_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
    "machine_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
    "app_actor": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
    "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9._:-]{1,128}$"}},
    "trust_level": {"const": "ATTENDED"},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "issuer": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
    "signature": {"$ref": "#/$defs/signature"}
  },
  "$defs": {
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": {"const": "Ed25519"},
        "key_id": {"type": "string", "pattern": "^ed25519:[a-f0-9]{24}$"},
        "value": {"type": "string", "minLength": 32}
      }
    }
  }
}
