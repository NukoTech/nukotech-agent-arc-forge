{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nukotech.invalid/hive/promotion-decision.v1.schema.json",
  "title": "Hive promotion decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "message_id", "reviewed_at", "reviewer", "outcome", "proposal_sha256", "conflicts", "signature"],
  "properties": {
    "schema_version": {"const": "hive.promotion-decision.v1"},
    "decision_id": {"type": "string", "format": "uuid"},
    "message_id": {"type": "string", "format": "uuid"},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "reviewer": {"type": "object", "additionalProperties": false, "required": ["worker_id", "grant_ref", "process_id", "process_namespace"], "properties": {"worker_id": {"type": "string", "minLength": 1}, "grant_ref": {"type": "string", "minLength": 1}, "process_id": {"type": "integer", "minimum": 1}, "process_namespace": {"type": "string", "pattern": "^HIVE-LAB-"}}},
    "outcome": {"enum": ["APPROVED", "CONFLICT", "REFUSED"]},
    "proposal_sha256": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "conflicts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["fact_key", "reason_code", "current_sha256", "expected_sha256"], "properties": {"fact_key": {"type": "string"}, "reason_code": {"enum": ["PRECONDITION_MISMATCH", "CURRENT_VALUE_CONTRADICTS_PROPOSAL", "MISSING_PRECONDITION"]}, "current_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "expected_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}}}},
    "signature": {"$ref": "#/$defs/signature"}
  },
  "$defs": {"signature": {"type": "object", "additionalProperties": false, "required": ["algorithm", "key_id", "value"], "properties": {"algorithm": {"const": "Ed25519"}, "key_id": {"type": "string", "pattern": "^ed25519:[0-9a-f]{24}$"}, "value": {"type": "string", "pattern": "^[A-Za-z0-9_-]{80,128}$"}}}}
}
