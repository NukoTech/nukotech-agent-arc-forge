{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nukotech.invalid/hive/task-envelope.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "task_id", "tenant_id", "workspace_id", "sender_agent",
    "recipient_agent", "required_capabilities", "required_trust", "operation", "payload",
    "payload_sha256", "provenance", "issued_at", "expires_at", "nonce", "signature"
  ],
  "properties": {
    "schema_version": {"const": "hive.task-envelope.v1"},
    "task_id": {"type": "string", "format": "uuid"},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "workspace_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "sender_agent": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
    "recipient_agent": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
    "required_capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9._:-]{1,128}$"}},
    "required_trust": {"enum": ["OBSERVE", "PROPOSE", "ATTENDED", "BOUNDED"]},
    "operation": {"type": "string", "pattern": "^[a-z0-9._:-]{1,128}$"},
    "payload": {"type": "object"},
    "payload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "provenance": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "nonce": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$"},
    "signature": {"$ref": "#/$defs/signature"}
  },
  "$defs": {
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": {"const": "Ed25519"},
        "key_id": {"type": "string", "pattern": "^ed25519:[a-f0-9]{24}$"},
        "value": {"type": "string", "minLength": 32}
      }
    }
  }
}
