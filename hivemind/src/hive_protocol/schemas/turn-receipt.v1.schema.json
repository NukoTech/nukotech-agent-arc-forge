{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nukotech.invalid/hive/turn-receipt.v1.schema.json",
  "title": "Hive Turn Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "message_id", "recorded_at", "retrieved_at", "environment", "artifacts", "proof", "privacy", "signature"],
  "properties": {
    "schema_version": {"const": "hive.turn-receipt.v1"},
    "receipt_id": {"type": "string", "format": "uuid"},
    "message_id": {"type": "string", "format": "uuid"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "retrieved_at": {"type": ["string", "null"], "format": "date-time"},
    "environment": {"enum": ["LAB", "STAGING"]},
    "privacy": {"const": "non-private"},
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["envelope_sha256", "delivery_sha256", "acknowledgment_sha256", "state_sha256", "vault_note_sha256", "promotion_sha256"],
      "properties": {
        "envelope_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "delivery_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "acknowledgment_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "state_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "vault_note_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "promotion_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exists", "current", "wired", "running", "delivered", "consumed", "changed_behavior", "persists_next_turn"],
      "properties": {
        "exists": {"const": "VERIFIED"},
        "current": {"const": "VERIFIED"},
        "wired": {"const": "VERIFIED"},
        "running": {"const": "VERIFIED"},
        "delivered": {"const": "VERIFIED"},
        "consumed": {"const": "VERIFIED"},
        "changed_behavior": {"const": "VERIFIED"},
        "persists_next_turn": {"enum": ["PENDING", "VERIFIED"]}
      }
    },
    "signature": {"$ref": "#/$defs/signature"}
  },
  "$defs": {
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": {"const": "Ed25519"},
        "key_id": {"type": "string", "pattern": "^ed25519:[0-9a-f]{24}$"},
        "value": {"type": "string", "pattern": "^[A-Za-z0-9_-]{80,128}$"}
      }
    }
  }
}
