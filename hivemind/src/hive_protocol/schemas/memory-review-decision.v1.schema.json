{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nukotech.invalid/hive/memory-review-decision.v1.schema.json",
  "title": "Hive memory review decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "candidate_id", "candidate_sha256", "tenant_id", "project_id", "experience_scope", "outcome", "corrections", "reviewer", "reviewed_at", "expires_at", "signature"],
  "properties": {
    "schema_version": {"const": "hive.memory-review-decision.v1"},
    "decision_id": {"type": "string", "pattern": "^review:[0-9a-f]{64}$"},
    "candidate_id": {"type": "string", "pattern": "^memory:[0-9a-f]{64}$"},
    "candidate_sha256": {"$ref": "#/$defs/sha256"},
    "tenant_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "experience_scope": {"$ref": "#/$defs/scope"},
    "outcome": {"enum": ["APPROVED", "REJECTED", "CHANGES_REQUESTED"]},
    "corrections": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 2048}},
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "authorization_ref", "key_id"],
      "properties": {"actor_id": {"$ref": "#/$defs/id"}, "authorization_ref": {"type": "string", "minLength": 1, "maxLength": 512}, "key_id": {"$ref": "#/$defs/key_id"}}
    },
    "reviewed_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "signature": {"$ref": "#/$defs/signature"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "key_id": {"type": "string", "pattern": "^ed25519:[0-9a-f]{24}$"},
    "scope": {"type": "object", "additionalProperties": false, "required": ["kind", "owner_id"], "properties": {"kind": {"enum": ["PERSONA", "SURFACE", "DOMAIN", "SHARED"]}, "owner_id": {"$ref": "#/$defs/id"}}},
    "signature": {"type": "object", "additionalProperties": false, "required": ["algorithm", "key_id", "value"], "properties": {"algorithm": {"const": "Ed25519"}, "key_id": {"$ref": "#/$defs/key_id"}, "value": {"type": "string", "pattern": "^[A-Za-z0-9_-]{80,128}$"}}}
  }
}
