{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nukotech.invalid/hive/agent-registry.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "agents"],
  "properties": {
    "schema_version": {"const": "hive.agent-registry.v1"},
    "agents": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agent_id", "tenant_id", "workspace_id", "persona_id", "surface_id",
          "capabilities", "trust_level", "recipient_aliases", "key_id", "public_key_pem", "active"
        ],
        "properties": {
          "agent_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
          "tenant_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "workspace_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "persona_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "surface_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "machine_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
          "project_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"}
          },
          "app_actor": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
          "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9._:-]{1,128}$"}},
          "trust_level": {"enum": ["OBSERVE", "PROPOSE", "ATTENDED", "BOUNDED"]},
          "recipient_aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"}},
          "key_id": {"type": "string", "pattern": "^ed25519:[a-f0-9]{24}$"},
          "public_key_pem": {"type": "string", "minLength": 32},
          "active": {"type": "boolean"}
        }
      }
    }
  }
}
