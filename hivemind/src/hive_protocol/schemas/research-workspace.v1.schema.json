{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nukotech.invalid/hive/research-workspace.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workspace_id", "tenant_id", "project_id", "name", "privacy_class", "created_at"],
  "properties": {
    "schema_version": {"const": "hive.research-workspace.v1"},
    "workspace_id": {"$ref": "#/$defs/safe_id"},
    "tenant_id": {"$ref": "#/$defs/safe_id"},
    "project_id": {"$ref": "#/$defs/safe_id"},
    "name": {"type": "string", "minLength": 1, "maxLength": 256},
    "privacy_class": {"enum": ["PROJECT_PRIVATE", "CUSTOMER_PRIVATE", "PERSONA_PRIVATE", "NON_PRIVATE"]},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "safe_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"}
  }
}
