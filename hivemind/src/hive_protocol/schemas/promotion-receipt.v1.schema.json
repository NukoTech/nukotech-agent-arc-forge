{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nukotech.invalid/hive/promotion-receipt.v1.schema.json",
  "title": "Hive promotion receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "message_id", "promoted_at", "promoter", "decision_sha256", "proposal_sha256", "artifacts", "bases", "moc_backlinks", "signature"],
  "properties": {
    "schema_version": {"const": "hive.promotion-receipt.v1"},
    "receipt_id": {"type": "string", "format": "uuid"},
    "message_id": {"type": "string", "format": "uuid"},
    "promoted_at": {"type": "string", "format": "date-time"},
    "promoter": {"type": "object", "additionalProperties": false, "required": ["worker_id", "grant_ref", "process_id", "process_namespace"], "properties": {"worker_id": {"type": "string", "minLength": 1}, "grant_ref": {"type": "string", "minLength": 1}, "process_id": {"type": "integer", "minimum": 1}, "process_namespace": {"type": "string", "pattern": "^HIVE-LAB-"}}},
    "decision_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "proposal_sha256": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "pattern": "^[A-Za-z0-9._ /-]+$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "bases": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9._ /-]+\\.base$"}},
    "moc_backlinks": {"type": "integer", "minimum": 1},
    "signature": {"$ref": "#/$defs/signature"}
  },
  "$defs": {"signature": {"type": "object", "additionalProperties": false, "required": ["algorithm", "key_id", "value"], "properties": {"algorithm": {"const": "Ed25519"}, "key_id": {"type": "string", "pattern": "^ed25519:[0-9a-f]{24}$"}, "value": {"type": "string", "pattern": "^[A-Za-z0-9_-]{80,128}$"}}}}
}
