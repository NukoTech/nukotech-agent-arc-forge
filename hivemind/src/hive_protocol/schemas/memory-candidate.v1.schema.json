{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nukotech.invalid/hive/memory-candidate.v1.schema.json",
  "title": "Hive memory candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "tenant_id", "project_id", "candidate_type", "proposed_action", "experience_scope", "subject_id", "claim", "evidence", "score", "sensitivity", "contradictions", "status", "source_event_ids", "extractor", "supersedes", "revokes", "retention_until", "created_at"],
  "properties": {
    "schema_version": {"const": "hive.memory-candidate.v1"},
    "candidate_id": {"type": "string", "pattern": "^memory:[0-9a-f]{64}$"},
    "tenant_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "candidate_type": {"$ref": "#/$defs/candidate_type"},
    "proposed_action": {"enum": ["CREATE", "CORRECT", "REVOKE"]},
    "experience_scope": {"$ref": "#/$defs/scope"},
    "subject_id": {"$ref": "#/$defs/id"},
    "claim": {"$ref": "#/$defs/claim"},
    "evidence": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/evidence"}},
    "score": {"$ref": "#/$defs/score"},
    "sensitivity": {"enum": ["PUBLIC", "INTERNAL", "PRIVATE", "SENSITIVE"]},
    "contradictions": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "pattern": "^node:[0-9a-f]{64}$"}},
    "status": {"const": "PROPOSED"},
    "source_event_ids": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "format": "uuid"}},
    "extractor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "mode"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "mode": {"enum": ["LOCAL_DETERMINISTIC", "OPTIONAL_PROVIDER_PROPOSED"]}
      }
    },
    "supersedes": {"$ref": "#/$defs/node_id"},
    "revokes": {"$ref": "#/$defs/node_id"},
    "retention_until": {"type": ["string", "null"], "format": "date-time"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "node_id": {"type": ["string", "null"], "pattern": "^node:[0-9a-f]{64}$"},
    "candidate_type": {"enum": ["PERSON", "ORGANIZATION", "PROJECT", "TOPIC", "ASSET", "DECISION", "COMMITMENT", "BLOCKER", "OUTCOME", "CORRECTION", "RELATIONSHIP", "EXPERIENCE", "CONTRADICTION", "STALE_KNOWLEDGE", "MISSING_CONTEXT"]},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "owner_id"],
      "properties": {"kind": {"enum": ["PERSONA", "SURFACE", "DOMAIN", "SHARED"]}, "owner_id": {"$ref": "#/$defs/id"}}
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value", "narrative"],
      "properties": {"key": {"$ref": "#/$defs/id"}, "value": {}, "narrative": {"type": "string", "minLength": 1, "maxLength": 8192}}
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "anchor_id", "source_sha256", "normalized_sha256"],
      "properties": {"source_id": {"$ref": "#/$defs/id"}, "anchor_id": {"$ref": "#/$defs/id"}, "source_sha256": {"$ref": "#/$defs/sha256"}, "normalized_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "feature_map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_quality", "repetition", "recency", "project_relevance", "source_trust", "contradiction", "sensitivity"],
      "properties": {
        "evidence_quality": {"type": "number", "minimum": 0, "maximum": 1},
        "repetition": {"type": "number", "minimum": 0, "maximum": 1},
        "recency": {"type": "number", "minimum": 0, "maximum": 1},
        "project_relevance": {"type": "number", "minimum": 0, "maximum": 1},
        "source_trust": {"type": "number", "minimum": 0, "maximum": 1},
        "contradiction": {"type": "number", "minimum": 0, "maximum": 1},
        "sensitivity": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "weight_map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_quality", "repetition", "recency", "project_relevance", "source_trust", "contradiction", "sensitivity"],
      "properties": {
        "evidence_quality": {"type": "number", "minimum": -1, "maximum": 1},
        "repetition": {"type": "number", "minimum": -1, "maximum": 1},
        "recency": {"type": "number", "minimum": -1, "maximum": 1},
        "project_relevance": {"type": "number", "minimum": -1, "maximum": 1},
        "source_trust": {"type": "number", "minimum": -1, "maximum": 1},
        "contradiction": {"type": "number", "minimum": -1, "maximum": 1},
        "sensitivity": {"type": "number", "minimum": -1, "maximum": 1}
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["features", "weights", "total"],
      "properties": {"features": {"$ref": "#/$defs/feature_map"}, "weights": {"$ref": "#/$defs/weight_map"}, "total": {"type": "number", "minimum": -1, "maximum": 1}}
    }
  }
}
