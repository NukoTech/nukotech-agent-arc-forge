{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nukotech.invalid/hive/loadout-plan.v1.schema.json",
  "title": "Hive signed declarative loadout plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "operation", "loadout_id", "target", "issued_at", "expires_at", "state_digest", "authorization_ref", "payload", "signature"],
  "properties": {
    "schema_version": {"const": "hive.loadout-plan.v1"},
    "plan_id": {"type": "string", "format": "uuid"},
    "operation": {"enum": ["admit", "revoke", "rollback", "uninstall"]},
    "loadout_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "target": {"$ref": "#/$defs/target"},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "state_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authorization_ref": {"type": "string", "minLength": 1, "maxLength": 512},
    "payload": {"type": "object"},
    "signature": {"$ref": "#/$defs/signature"}
  },
  "$defs": {
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["persona_id", "surface_id", "machine_id", "project_id", "os", "architecture", "runtime"],
      "properties": {
        "persona_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "surface_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "machine_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "project_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "os": {"enum": ["macos", "linux", "windows"]},
        "architecture": {"enum": ["arm64", "aarch64", "x86_64"]},
        "runtime": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": {"const": "Ed25519"},
        "key_id": {"type": "string", "pattern": "^ed25519:[0-9a-f]{24}$"},
        "value": {"type": "string", "minLength": 80, "maxLength": 128}
      }
    }
  }
}
