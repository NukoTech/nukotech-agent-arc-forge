{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nukotech.invalid/hive/work-envelope.v2.schema.json",
  "title": "Hive Work Envelope v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "message_id", "issued_at", "expires_at", "nonce", "identity", "recipient", "authority", "task", "provenance", "signature"],
  "properties": {
    "schema_version": {"const": "hive.work-envelope.v2"},
    "message_id": {"type": "string", "format": "uuid"},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "nonce": {"type": "string", "pattern": "^[A-Za-z0-9_-]{32,128}$"},
    "identity": {"$ref": "#/$defs/identity_context"},
    "recipient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "machine", "project"],
      "properties": {
        "surface": {"type": "string", "minLength": 1},
        "machine": {"type": "string", "minLength": 1},
        "project": {"type": "string", "minLength": 1}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "authorization_ref", "capabilities"],
      "properties": {
        "environment": {"enum": ["LAB", "STAGING", "PRODUCTION"]},
        "authorization_ref": {"type": "string", "minLength": 1},
        "capabilities": {"type": "array", "uniqueItems": true, "minItems": 1, "items": {"type": "string", "pattern": "^[a-z0-9_.:-]+$"}}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "operation", "key", "expected", "value"],
      "properties": {
        "kind": {"const": "state-transition"},
        "operation": {"const": "compare-and-set"},
        "key": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]+$"},
        "expected": {"type": ["string", "number", "boolean", "null"]},
        "value": {"type": ["string", "number", "boolean", "null"]}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "branch", "commit", "issue", "source_records"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "branch": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "issue": {"type": "string", "format": "uri"},
        "source_records": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["ref", "sha256", "status"], "properties": {"ref": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "status": {"enum": ["VERIFIED", "CONFLICT", "UNKNOWN"]}}}}
      }
    },
    "signature": {"$ref": "#/$defs/signature"}
  },
  "$defs": {
    "identity_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "persona", "surface", "agent_worker", "model_runtime", "machine_node", "domain_product_project", "governance_seat", "memory_vault_namespace", "capability_authority"],
      "properties": {
        "schema_version": {"const": "hive.identity-context.v1"},
        "persona": {"type": "object", "additionalProperties": false, "required": ["id", "continuity_id", "governance_role"], "properties": {"id": {"type": "string", "minLength": 1}, "continuity_id": {"type": "string", "minLength": 1}, "governance_role": {"enum": ["QUEEN", "NODE_PERSONA", "NONE"]}}},
        "surface": {"type": "object", "additionalProperties": false, "required": ["id", "channel", "persona_continuity_id", "experience_namespace"], "properties": {"id": {"type": "string", "minLength": 1}, "channel": {"type": "string", "minLength": 1}, "persona_continuity_id": {"type": "string", "minLength": 1}, "experience_namespace": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"}}},
        "agent_worker": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "ephemeral", "acts_for_persona"], "properties": {"id": {"type": "string", "minLength": 1}, "kind": {"enum": ["ORCHESTRATOR", "DIRECTOR", "BUILDER", "OBSERVER", "CONSUMER"]}, "ephemeral": {"type": "boolean"}, "acts_for_persona": {"type": "string", "minLength": 1}}},
        "model_runtime": {"type": "object", "additionalProperties": false, "required": ["model", "runtime", "provider"], "properties": {"model": {"type": "string", "minLength": 1}, "runtime": {"type": "string", "minLength": 1}, "provider": {"type": "string", "minLength": 1}}},
        "machine_node": {"type": "object", "additionalProperties": false, "required": ["machine", "node_id", "node_class", "environment"], "properties": {"machine": {"type": "string", "minLength": 1}, "node_id": {"type": "string", "minLength": 1}, "node_class": {"enum": ["PRIME", "INTERNAL", "CUSTOMER", "LAB"]}, "environment": {"enum": ["LAB", "STAGING", "PRODUCTION"]}}},
        "domain_product_project": {"type": "object", "additionalProperties": false, "required": ["domain", "product", "project"], "properties": {"domain": {"type": "string", "minLength": 1}, "product": {"type": "string", "minLength": 1}, "project": {"type": "string", "minLength": 1}}},
        "governance_seat": {"type": "object", "additionalProperties": false, "required": ["persona_seat", "worker_seat", "grant_ref"], "properties": {"persona_seat": {"type": "string", "minLength": 1}, "worker_seat": {"type": "string", "minLength": 1}, "grant_ref": {"type": "string", "minLength": 1}}},
        "memory_vault_namespace": {"type": "object", "additionalProperties": false, "required": ["vault", "tier", "namespace", "raw_memory_in_github"], "properties": {"vault": {"type": "string", "minLength": 1}, "tier": {"enum": ["PERSONA_PRIVATE", "SURFACE_PRIVATE", "PROJECT_PRIVATE", "CUSTOMER_PRIVATE", "PRIME_SHARED", "NON_PRIVATE_RECEIPTS"]}, "namespace": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"}, "raw_memory_in_github": {"const": false}}},
        "capability_authority": {"type": "object", "additionalProperties": false, "required": ["authorization_ref", "capabilities", "enforcement", "expires_at"], "properties": {"authorization_ref": {"type": "string", "minLength": 1}, "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_.:-]+$"}}, "enforcement": {"enum": ["LOCAL_FAIL_CLOSED", "OBSERVATION_ONLY"]}, "expires_at": {"type": "string", "format": "date-time"}}}
      }
    },
    "signature": {"type": "object", "additionalProperties": false, "required": ["algorithm", "key_id", "value"], "properties": {"algorithm": {"const": "Ed25519"}, "key_id": {"type": "string", "pattern": "^ed25519:[0-9a-f]{24}$"}, "value": {"type": "string", "pattern": "^[A-Za-z0-9_-]{80,128}$"}}}
  }
}
