{
  "schema_version": "hive.application-adapter-manifest.v1",
  "adapter_id": "nukotech.hive.local-capture",
  "name": "NukoTech Hive Governed Local Capture",
  "version": "1.0.0",
  "maintainer": "NukoTech HiveMind",
  "capability_ids": [
    "capture.audio",
    "capture.browser-handoff",
    "capture.clipboard",
    "capture.file",
    "capture.folder-handoff",
    "capture.image",
    "capture.markdown",
    "capture.meeting-recording",
    "capture.pdf",
    "capture.text",
    "capture.transcript",
    "capture.video",
    "capture.webpage-snapshot"
  ],
  "execution_mode": "NATIVE",
  "platforms": [
    {"os": "linux", "architecture": "aarch64", "runtime": "python>=3.11"},
    {"os": "linux", "architecture": "x86_64", "runtime": "python>=3.11"},
    {"os": "macos", "architecture": "arm64", "runtime": "python>=3.11"},
    {"os": "macos", "architecture": "x86_64", "runtime": "python>=3.11"}
  ],
  "required_permissions": [
    "filesystem.read.project-source",
    "filesystem.write.adapter-state",
    "filesystem.write.workspace"
  ],
  "accepted_data_classifications": ["PROJECT_PRIVATE"],
  "request_schema": "hive.adapter-request.v1",
  "result_schema": "hive.adapter-result.v1",
  "events": ["capture.applied", "capture.refused"],
  "network_destinations": [],
  "credential_references": [],
  "dependencies": [],
  "health_check": {
    "entrypoint": "python -m hive_protocol.adapters.capture.local health",
    "timeout_seconds": 10
  },
  "export": {
    "entrypoint": "python -m hive_protocol.adapters.capture.local export",
    "timeout_seconds": 300
  },
  "revocation_check": {
    "entrypoint": "runtime:adapter-registry-revocation-check",
    "timeout_seconds": 10
  },
  "rollback": {
    "entrypoint": "python -m hive_protocol.adapters.capture.local rollback",
    "timeout_seconds": 300
  },
  "uninstall": {
    "entrypoint": "runtime:adapter-lifecycle-uninstall",
    "timeout_seconds": 300
  },
  "resource_limits": {
    "max_input_bytes": 10485760,
    "max_output_bytes": 10485760,
    "timeout_seconds": 300
  },
  "retention": {
    "policy": "Preserve imported sources, provenance, and receipts until explicitly authorized archival.",
    "delete_method": "Manifest-bound removal of adapter-owned staging only."
  },
  "offline_behavior": "SUPPORTED",
  "signer_policy": {
    "issuer": "NukoTech HiveMind attended alpha",
    "allowed_key_ids": ["deployment-pinned-ed25519-key-id"]
  }
}
