{
  "schema_version": "hive.application-adapter-manifest.v1",
  "adapter_id": "nukotech.hive.bounded-research",
  "name": "NukoTech Hive Bounded Local Research",
  "version": "1.0.0",
  "maintainer": "NukoTech HiveMind",
  "capability_ids": ["research.artifact", "research.ask", "research.search"],
  "execution_mode": "NATIVE",
  "platforms": [
    {"os": "linux", "architecture": "aarch64", "runtime": "python>=3.11"},
    {"os": "linux", "architecture": "x86_64", "runtime": "python>=3.11"},
    {"os": "macos", "architecture": "arm64", "runtime": "python>=3.11"},
    {"os": "macos", "architecture": "x86_64", "runtime": "python>=3.11"}
  ],
  "required_permissions": [
    "filesystem.read.workspace",
    "filesystem.write.adapter-state",
    "filesystem.write.workspace"
  ],
  "accepted_data_classifications": ["PROJECT_PRIVATE"],
  "request_schema": "hive.adapter-request.v1",
  "result_schema": "hive.adapter-result.v1",
  "events": ["research.completed", "research.refused"],
  "network_destinations": [],
  "credential_references": [],
  "dependencies": [],
  "health_check": {
    "entrypoint": "python -m hive_protocol.adapters.research.bounded health",
    "timeout_seconds": 10
  },
  "export": {
    "entrypoint": "python -m hive_protocol.adapters.research.bounded export",
    "timeout_seconds": 300
  },
  "revocation_check": {
    "entrypoint": "runtime:adapter-registry-revocation-check",
    "timeout_seconds": 10
  },
  "rollback": {
    "entrypoint": "python -m hive_protocol.adapters.research.bounded rollback",
    "timeout_seconds": 300
  },
  "uninstall": {
    "entrypoint": "runtime:adapter-lifecycle-uninstall",
    "timeout_seconds": 300
  },
  "resource_limits": {
    "max_input_bytes": 1048576,
    "max_output_bytes": 10485760,
    "timeout_seconds": 300
  },
  "retention": {
    "policy": "Preserve canonical workspace sources and signed research receipts.",
    "delete_method": "Manifest-bound removal of adapter-owned derived state only."
  },
  "offline_behavior": "SUPPORTED",
  "signer_policy": {
    "issuer": "NukoTech HiveMind attended alpha",
    "allowed_key_ids": ["deployment-pinned-ed25519-key-id"]
  }
}
