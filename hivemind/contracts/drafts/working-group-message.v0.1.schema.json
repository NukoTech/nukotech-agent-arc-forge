{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nukotech.invalid/hive/working-group-message.v0.1.schema.json",
  "title": "Hive Working-Group Message v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "message_id", "created_at", "expires_at", "nonce",
    "sender", "recipient", "project_id", "message_class", "state",
    "authority_ref", "payload_ref", "provenance", "content_sha256", "signature"
  ],
  "properties": {
    "schema_version": {"const": "hive.working-group-message.v0.1"},
    "message_id": {"type": "string", "format": "uuid"},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "nonce": {"type": "string", "pattern": "^[A-Za-z0-9_-]{32,128}$"},
    "sender": {"$ref": "#/$defs/endpoint"},
    "recipient": {"$ref": "#/$defs/endpoint"},
    "project_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
    "message_class": {
      "enum": [
        "ANNOUNCEMENT", "REQUEST", "PERMISSION_REQUEST", "SUGGESTION",
        "DISCUSSION", "DECISION", "WORK_ORDER", "HANDOFF",
        "VERIFICATION_RECEIPT", "ACKNOWLEDGMENT", "BLOCKER"
      ]
    },
    "state": {
      "enum": ["WRITTEN", "ROUTED", "DELIVERED", "CONSUMED", "ACKNOWLEDGED", "ACTED"]
    },
    "authority_ref": {"type": "string", "minLength": 1, "maxLength": 512},
    "payload_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["media_type", "uri", "sha256", "data_classification"],
      "properties": {
        "media_type": {"type": "string", "minLength": 1},
        "uri": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "data_classification": {"enum": ["NON_PRIVATE", "PROJECT_PRIVATE", "SURFACE_PRIVATE"]}
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "sha256"],
        "properties": {
          "ref": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature": {"$ref": "#/$defs/signature"}
  },
  "$defs": {
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["persona_id", "surface_id", "machine_id"],
      "properties": {
        "persona_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
        "surface_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
        "machine_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"}
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": {"const": "Ed25519"},
        "key_id": {"type": "string", "pattern": "^ed25519:[0-9a-f]{24}$"},
        "value": {"type": "string", "pattern": "^[A-Za-z0-9_-]{80,128}$"}
      }
    }
  }
}
